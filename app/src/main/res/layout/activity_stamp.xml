<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNearestCourse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 내 위치 탐색 중..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:background="#FFCDD2"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnCourse1"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="1-1구간 (임랑해수욕장 ~ 기장군청)\n거리: 12.2km | 난이도: 쉬움"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnCourse2"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="2-1구간 (문탠로드 ~ 오륙도)\n거리: 5.7km | 난이도: 보통"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnCourse3"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="3-1구간 (오륙도 ~ 태종대)\n거리: 11.5km | 난이도: 어려움" />
</LinearLayout>
